# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ipx:ipx_dev_password@localhost:5432/ip_exchange

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Auth (used from Phase 2 onward) ---
